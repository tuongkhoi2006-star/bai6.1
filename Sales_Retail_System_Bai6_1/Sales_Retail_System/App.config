<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Sua Data Source cho dung voi SQL Server tren may. Vi du: .\SQLEXPRESS hoac (localdb)\MSSQLLocalDB -->
    <add name="SalesDB" connectionString="Data Source=.;Initial Catalog=SalesDB;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
